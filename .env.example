# ── Neo4j (Tier 1 SSoT) ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ibn-closed-loop-2026
NEO4J_DATABASE=neo4j

# ── Live-Memory MCP (Tier 2) ─────────────────────────────────────────────────
LIVE_MEMORY_URL=http://localhost:8002
LIVE_MEMORY_TOKEN=changeme-agent-token

# Admin bootstrap key — used once to create agent tokens
ADMIN_BOOTSTRAP_KEY=changeme-generate-with-openssl-rand-hex-32

# ── LLM for bank_consolidate() ───────────────────────────────────────────────
LLMAAS_API_URL=https://api.ai.cloud-temple.com/v1
LLMAAS_API_KEY=your-llm-api-key
LLMAAS_MODEL=qwen3-2507:235b
LLMAAS_MAX_TOKENS=100000
LLMAAS_TEMPERATURE=0.3

# ── Graph-Memory MCP (Tier 3 — Phase 2) ─────────────────────────────────────
# GRAPH_MEMORY_URL=http://localhost:8003
# GRAPH_MEMORY_TOKEN=changeme-graph-token

# ── NetLab SSH (Phase 1 orchestration) ──────────────────────────────────────
# NETLAB_SSH_HOST=192.168.1.100
# NETLAB_SSH_USER=vyos
# NETLAB_SSH_KEY=/home/user/.ssh/netlab_ed25519

# ── Event bus (Phase 1 uses in-process bus; flip to Redis/Kafka in Phase 2) ──
# EVENT_BUS_TYPE=redis
# REDIS_URL=redis://localhost:6379

# ── Consolidation tuning ─────────────────────────────────────────────────────
CONSOLIDATION_TIMEOUT=600
CONSOLIDATION_MAX_NOTES=500
