{# SR Linux physical interface admin state.
   Slice 2: bring ethernet-1/1 up as the trunk port. Slice 6 will
   extend this with LAG bundles, LLDP/CDP, port-security. #}
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "Trunk to access layer (HLD-driven)"
set / interface ethernet-1/1 vlan-tagging true
